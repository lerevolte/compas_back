<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  Options -Multiviews

  # Serve existing files/directories as-is
  RewriteCond %{REQUEST_FILENAME} -s [OR]
  RewriteCond %{REQUEST_FILENAME} -l [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Internal rewrite for SPA deep links; keeps URL (no redirect)
  RewriteRule ^objects/.*$ index.html [L]

  # Fallback all other requests to index.html (SPA routing)
  RewriteRule . index.html [L]
</IfModule>

# If mod_rewrite is not available, try FallbackResource (if supported)
<IfModule !mod_rewrite.c>
  FallbackResource /index.html
</IfModule>
